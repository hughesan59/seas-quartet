---
import Layout from '../layouts/Layout.astro';
import { getSingle } from '../utils/content';
import { Image, getImage } from 'astro:assets';
import { withBase } from '../utils/base';

const home = (await getSingle('home')).data;

const avif = { format: 'avif', quality: 45 } as const;
const LANDSCAPE_WIDTHS = [640, 960, 1280, 1920, 2560];
const LANDSCAPE_SIZES = 'max(100vw, 135vh)';
const LANDSCAPE_WIDTH = 1920;
const PORTRAIT_WIDTH = 1280;

const landscapeImage = await getImage({
	src: home.heroImage,
	width: LANDSCAPE_WIDTH,
	widths: LANDSCAPE_WIDTHS,
	...avif,
});
const portraitImage = await getImage({
	src: home.heroImage,
	width: PORTRAIT_WIDTH,
	height: Math.round((PORTRAIT_WIDTH * 16) / 9),
	fit: 'cover',
	position: 'attention',
	widths: [640, 750, 828, 960, 1080, PORTRAIT_WIDTH],
	...avif,
});
---

<Layout description={home.pageDescription}>
	<main class="relative min-h-[90vh] -mt-[73px] flex flex-col items-center justify-center">
		<picture>
			<source
				media="(max-aspect-ratio: 3/4)"
				srcset={portraitImage.srcSet.attribute}
				sizes="max(100vw, 50.625vh)"
				type="image/avif"
			/>
			<source
				srcset={landscapeImage.srcSet.attribute}
				sizes={LANDSCAPE_SIZES}
				type="image/avif"
			/>
			<Image
				src={home.heroImage}
				alt={home.heroImageAlt}
				width={LANDSCAPE_WIDTH}
				widths={LANDSCAPE_WIDTHS}
				sizes={LANDSCAPE_SIZES}
				class="absolute inset-0 w-full h-full object-cover"
				loading="eager"
				fetchpriority="high"
			/>
		</picture>
		<div class="relative flex flex-col items-center justify-between min-h-[90vh] py-24 px-6">
			<p class="font-accent text-sm tracking-[0.3em] text-[#F7EEE5]/60 uppercase">
				{home.heroLabel}
			</p>
			<h1 class="font-display italic font-semibold text-5xl md:text-9xl text-[#F7EEE5] text-center tracking-tight">
				{home.heroTitle}
			</h1>
			<a
				class="inline-block px-12 py-4 border border-primary text-primary font-accent text-sm tracking-widest uppercase hover:bg-primary hover:text-background-dark transition-all duration-300"
				href={withBase('/about/')}>
				{home.heroButtonText}
			</a>
		</div>
	</main>
</Layout>
