---
import Layout from '../layouts/Layout.astro';
import { getSingle } from '../utils/content';

const { pageTitle, pageDescription, label, heading, note, categories } = (
	await getSingle('repertoire')
).data;
---

<Layout title={pageTitle} description={pageDescription} theme="light">
	<main class="max-w-4xl mx-auto px-6 py-20 text-center">
		<div class="mb-16">
			<p class="font-accent text-sm tracking-[0.3em] text-primary mb-4 uppercase">
				{label}
			</p>
			<h1 class="font-display italic text-4xl md:text-6xl text-stone-900 mb-6">
				{heading}
			</h1>
			{note && <p class="font-body tracking-wider text-sm">{note}</p>}
		</div>
		<div class="space-y-20">
			{categories.map((category) => (
				<section>
					<h2 class="font-display italic text-2xl md:text-3xl text-primary mb-8">
						{category.title}
					</h2>
					<ul class="flex flex-col border-t border-primary/20 list-none p-0 m-0">
						{category.pieces.map((piece) => (
							<li class="border-b border-primary/20 last:border-b-0 py-4 px-2">
								<p class="text-sm md:text-base tracking-wide">
									<span class="font-semibold">{piece.composer}</span>
									<span class="sr-only">{': '}</span>
									<span
										class="diamond relative -top-[0.1em] align-middle mx-2"
										aria-hidden="true"
									/>
									{piece.title}
								</p>
							</li>
						))}
					</ul>
				</section>
			))}
		</div>
	</main>
</Layout>
