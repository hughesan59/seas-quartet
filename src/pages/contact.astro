---
import Layout from '../layouts/Layout.astro';
import { getSingle } from '../utils/content';

const contact = (await getSingle('contact')).data;
const mailto = `mailto:${contact.email}`;
---

<Layout
	title={contact.pageTitle}
	description={contact.pageDescription}
	theme="light"
	showBookingCta={false}>
	<main class="flex-grow flex flex-col items-center py-20 px-6">
		<div class="max-w-2xl w-full text-center mb-12">
			<p class="font-accent text-sm tracking-[0.3em] text-primary mb-4 uppercase">
				{contact.label}
			</p>
			<h1 class="font-display italic text-4xl md:text-6xl text-stone-900 mb-2">
				{contact.heading}
			</h1>
			<p class="font-display italic text-2xl md:text-3xl text-primary mt-6">
				{contact.subheading}
			</p>
		</div>
		<div class="max-w-xl w-full text-center space-y-10">
			<div class="space-y-8">
				<p class="text-stone-700 text-lg leading-relaxed">{contact.intro}</p>
				<ul class="w-fit mx-auto text-left space-y-2 text-stone-700 text-lg">
					{contact.details.map((detail) => (
						<li class="flex items-center gap-4 before:diamond">{detail}</li>
					))}
				</ul>
			</div>
			<a
				class="inline-block border border-primary/40 hover:border-primary px-12 py-4 text-sm font-accent tracking-widest text-primary hover:bg-primary/5 transition-all duration-300 uppercase"
				href={mailto}>
				{contact.buttonText}
			</a>
			<p class="text-stone-500">
				{contact.emailPrompt}{' '}
				<a
					class="text-primary underline underline-offset-4 decoration-primary/40 hover:decoration-primary break-all"
					href={mailto}>
					{contact.email}
				</a>
			</p>
		</div>
	</main>
</Layout>
