---
import { getSingle } from '../utils/content';
import { absoluteUrl, withBase } from '../utils/base';
import { socialLinks } from '../utils/socials';

interface Props {
	/** Absolute URL of the share photo, which Layout also uses for `og:image`. */
	image: string;
}

const { image } = Astro.props;

const settings = (await getSingle('settings')).data;
const about = (await getSingle('about')).data;
const contact = (await getSingle('contact')).data;

const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'MusicGroup',
	name: settings.title,
	url: absoluteUrl(withBase('/')),
	description: settings.description,
	foundingDate: String(settings.foundingYear),
	genre: settings.genres,
	image,
	areaServed: settings.areaServed,
	member: about.members.map((m) => ({
		'@type': 'Person',
		name: m.name,
		roleName: m.instrument,
	})),
	sameAs: socialLinks(settings).map((link) => link.href),
	contactPoint: {
		'@type': 'ContactPoint',
		contactType: 'booking',
		email: contact.email,
		url: absoluteUrl(withBase('/contact/')),
	},
};
---

<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
