---
import { getEntry } from 'astro:content';
import { getImage } from 'astro:assets';
import siteData from '../data/site.json';
import { withBase } from '../utils/base';

const sdEntry = await getEntry('structuredData', 'structured-data');
const aboutEntry = await getEntry('about', 'about');
const socialsEntry = await getEntry('socials', 'socials');

const absoluteUrl = (path: string) => new URL(path, Astro.site).href;
const image = await getImage({ src: sdEntry.data.image, format: 'jpg' });

const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'MusicGroup',
	name: siteData.title,
	url: absoluteUrl(withBase('/')),
	description: sdEntry.data.description,
	foundingDate: sdEntry.data.foundingDate,
	genre: sdEntry.data.genres,
	image: absoluteUrl(image.src),
	areaServed: sdEntry.data.areaServed,
	member: aboutEntry.data.members.map((m) => ({
		'@type': 'Person',
		name: m.name,
		roleName: m.instrument,
	})),
	sameAs: socialsEntry.data.links
		.filter((link) => link.href)
		.map((link) => link.href),
	...(sdEntry.data.email && {
		contactPoint: {
			'@type': 'ContactPoint',
			contactType: 'booking',
			email: sdEntry.data.email,
			...(sdEntry.data.telephone && { telephone: sdEntry.data.telephone }),
			url: absoluteUrl(withBase('/contact/')),
		},
	}),
};
---

<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
