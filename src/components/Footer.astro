---
import { getSingle } from '../utils/content';
import { withBase } from '../utils/base';
import { socialLinks } from '../utils/socials';

interface Props {
	showCta?: boolean;
	isLight?: boolean;
}

const { showCta = true, isLight = false } = Astro.props;
const settings = (await getSingle('settings')).data;
const links = socialLinks(settings);
---

<footer class="text-center px-6">
	{showCta && (
		<div
			class:list={[
				'border-t pt-16 pb-8 max-w-4xl mx-auto',
				isLight ? 'border-primary/20' : 'border-primary/10',
			]}>
			<h2
				class:list={[
					'font-display text-2xl mb-8 italic',
					isLight ? 'text-stone-900' : 'text-white',
				]}>
				{settings.ctaHeading}
			</h2>
			<a
				class="inline-block px-12 py-4 border border-primary text-primary font-accent text-sm tracking-widest uppercase hover:bg-primary hover:text-background-dark transition-all duration-300"
				href={withBase('/contact/')}>
				{settings.ctaButtonText}
			</a>
		</div>
	)}
	<nav
		aria-label="Social media"
		class="py-12 flex justify-center space-x-8 text-primary">
		{links.map((link) => (
			<a href={link.href} target="_blank" rel="noopener noreferrer">
				<span class="sr-only">{link.platform}</span>
				<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
					<path d={link.iconPath} />
				</svg>
			</a>
		))}
	</nav>
</footer>
