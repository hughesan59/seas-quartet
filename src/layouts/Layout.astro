---
import { getSingle } from '../utils/content';
import { Font, getImage } from 'astro:assets';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import JsonLd from '../components/JsonLd.astro';
import { absoluteUrl, withBase } from '../utils/base';

interface Props {
	title?: string;
	description?: string;
	theme?: 'dark' | 'light';
	showBookingCta?: boolean;
}

const {
	title,
	description,
	theme = 'dark',
	showBookingCta = true,
} = Astro.props;
const settings = (await getSingle('settings')).data;
const pageTitle = title
	? `${title} | ${settings.title}`
	: `${settings.title} - ${settings.tagline}`;
const pageDescription = description || settings.description;
const isLight = theme === 'light';

const canonicalUrl = absoluteUrl(Astro.url.pathname);
// Link-preview scrapers expect a 1.91:1 JPEG; AVIF/WebP aren't reliably read.
const shareImage = await getImage({
	src: settings.sharePhoto,
	width: 1200,
	height: 630,
	fit: 'cover',
	format: 'jpg',
});
const shareImageUrl = absoluteUrl(shareImage.src);
---

<!doctype html>
<html lang="en-GB" class:list={[isLight && 'theme-light']}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
		<Font cssVariable="--display-font" />
		<Font cssVariable="--accent-font" />
		<Font cssVariable="--body-font" />

		<meta name="description" content={pageDescription} />
		<link rel="canonical" href={canonicalUrl} />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={pageDescription} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:site_name" content={settings.title} />
		<meta property="og:locale" content="en_GB" />
		<meta property="og:image" content={shareImageUrl} />
		<meta
			property="og:image:width"
			content={String(shareImage.attributes.width)}
		/>
		<meta
			property="og:image:height"
			content={String(shareImage.attributes.height)}
		/>
		<meta property="og:image:alt" content={settings.sharePhotoAlt} />
		<meta name="twitter:card" content="summary_large_image" />
		<title>{pageTitle}</title>
		<JsonLd image={shareImageUrl} />
		<script is:inline>
			document.documentElement.setAttribute('data-js', '');
		</script>
	</head>
	<body
		class:list={[
			'min-h-screen flex flex-col',
			isLight
				? 'bg-background-light text-stone-800'
				: 'bg-background-dark text-stone-300',
		]}>
		<Header isLight={isLight} />
		<div id="page-content" class="flex-grow flex flex-col">
			<slot />
			<Footer showCta={showBookingCta} isLight={isLight} />
		</div>
	</body>
</html>
