{
	"plugins": ["prettier-plugin-astro"],
	"overrides": [
		{
			"files": "*.astro",
			"options": {
				"parser": "astro"
			}
		},
		{
			"files": "src/content/**/*.md",
			"options": {
				"singleQuote": false
			}
		}
	],
	"useTabs": true,
	"singleQuote": true,
	"trailingComma": "all",
	"bracketSameLine": true,
	"htmlWhitespaceSensitivity": "ignore"
}
